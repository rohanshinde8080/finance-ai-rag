# ==========================================
# FinanceAI Root .gitignore
# ==========================================

# Environment variables & secrets (CRITICAL: Never commit API keys)
.env
.env.*
*.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Python virtual environments & bytecode
.venv/
backend/.venv/
env/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & coverage
.pytest_cache/
backend/.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.cover

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/build/
*.local

# Storage & generated uploads
backend/storage/documents/*
!backend/storage/documents/.gitkeep
backend/storage/vector_indices/*.faiss
backend/storage/vector_indices/*.pkl
!backend/storage/vector_indices/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & IDE
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

