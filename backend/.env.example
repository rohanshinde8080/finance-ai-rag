# ==========================================
# FinanceAI Backend Environment Configuration
# ==========================================

# Application
APP_NAME=FinanceAI
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Database (PostgreSQL with pgvector)
# Format: postgresql://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_ai_db
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=10
DB_TIMEOUT_SECONDS=10

# Security & JWT Authentication
# Generate a strong 32+ character key for production (e.g., openssl rand -hex 32)
JWT_SECRET_KEY=dev_secret_key_change_in_production_finance_ai_super_secret_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Default Administrator (Seeded if no admin exists)
INITIAL_ADMIN_EMAIL=admin@financeai.com
INITIAL_ADMIN_PASSWORD=AdminSecure#2026!
INITIAL_ADMIN_NAME="System Administrator"

# AI Models & External APIs (For subsequent phases)
GEMINI_API_KEY=placeholder_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
TAVILY_API_KEY=placeholder_tavily_api_key

# RAG Hyperparameters
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_SIZE=800
CHUNK_OVERLAP=100
SIMILARITY_THRESHOLD=0.70
TOP_K_CHUNKS=4

